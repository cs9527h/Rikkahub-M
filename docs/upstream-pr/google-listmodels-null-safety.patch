From: re-ovo <1609403959@qq.com>
Date: Wed, 25 Nov 2026 12:50:53 +0800
Subject: [PATCH] =?UTF-8?q?fix(google):=20listModels=20=E9=80=90=E5=AD=97?=
 =?UTF-8?q?=E6=AE=B5=E7=A9=BA=E5=AE=89=E5=85=A8=EF=BC=8C=E5=A4=B1=E8=B4=A5?=
 =?UTF-8?q?=E5=88=86=E6=94=AF=E5=85=B3=E9=97=AD=E8=BF=9E=E6=8E=A5?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- supportedGenerationMethods / name 用 !! 取，缺字段的兼容接口会让整个模型列表加载失败；
  改为单条畸形只丢该条。
- 失败分支补 response.close()，避免连接被占住直到 GC。
---
 .../providers/google/GoogleProvider.kt        | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/ai/src/main/java/me/rerere/ai/provider/providers/google/GoogleProvider.kt b/ai/src/main/java/me/rerere/ai/provider/providers/google/GoogleProvider.kt
index 1feabc54..1a67260a 100644
--- a/ai/src/main/java/me/rerere/ai/provider/providers/google/GoogleProvider.kt
+++ b/ai/src/main/java/me/rerere/ai/provider/providers/google/GoogleProvider.kt
@@ -67,6 +67,8 @@ import me.rerere.ai.util.mergeCustomHeaders
 import me.rerere.ai.util.removeElements
 import me.rerere.ai.util.stringSafe
 import me.rerere.common.http.await
+import me.rerere.common.http.jsonArrayOrNull
+import me.rerere.common.http.jsonObjectOrNull
 import me.rerere.common.http.jsonPrimitiveOrNull
 import me.rerere.common.http.sse.newEventSource
 import okhttp3.HttpUrl
@@ -152,20 +154,25 @@ class GoogleProvider(private val client: OkHttpClient, context: Context? = null)
                 val body = response.body?.string() ?: error("empty body")
                 Log.d(TAG, "listModels: $body")
                 val bodyObject = json.parseToJsonElement(body).jsonObject
-                val models = bodyObject["models"]?.jsonArray ?: return@withContext emptyList()
+                val models = bodyObject["models"]?.jsonArrayOrNull ?: return@withContext emptyList()
 
                 models.mapNotNull {
-                    val modelObject = it.jsonObject
+                    // 单个条目畸形只丢自己：兼容接口普遍少字段，用 !! 会让整个模型列表加载失败。
+                    val modelObject = it.jsonObjectOrNull ?: return@mapNotNull null
 
                     // 忽略非chat/embedding模型
                     val supportedGenerationMethods =
-                        modelObject["supportedGenerationMethods"]!!.jsonArray
-                            .map { method -> method.jsonPrimitive.content }
+                        modelObject["supportedGenerationMethods"]?.jsonArrayOrNull
+                            ?.mapNotNull { method -> method.jsonPrimitiveOrNull?.contentOrNull }
+                            .orEmpty()
                     if ("generateContent" !in supportedGenerationMethods && "embedContent" !in supportedGenerationMethods) {
                         return@mapNotNull null
                     }
 
-                    val modelId = modelObject["name"]!!.jsonPrimitive.content.substringAfter("/")
+                    val modelId = modelObject["name"]?.jsonPrimitiveOrNull?.contentOrNull
+                        ?.substringAfter("/")
+                        ?.takeIf { it.isNotBlank() }
+                        ?: return@mapNotNull null
                     Model(
                         modelId = modelId,
                         // 部分兼容接口不返回 displayName，回退到 modelId
@@ -175,6 +182,8 @@ class GoogleProvider(private val client: OkHttpClient, context: Context? = null)
                     )
                 }
             } else {
+                // 失败分支必须消费/关闭 body，否则连接一直被占住（await() 只负责取回 Response）。
+                response.close()
                 emptyList()
             }
         }
