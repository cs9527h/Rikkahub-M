- executeWithRetry 原来对 4xx（鉴权失败、参数错误）也做退避重试，白等两轮；
  现在 4xx 直接上抛，只有网络异常与 5xx 才重试。
- 异常消息里去掉 resp.body.string()：响应体可能回显识别文本，且会被 Log.w 打进日志。
---
 .../main/java/me/rerere/asr/providers/StepASRController.kt | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/speech/src/main/java/me/rerere/asr/providers/StepASRController.kt b/speech/src/main/java/me/rerere/asr/providers/StepASRController.kt
index 2fcb66e8..05de2774 100644
--- a/speech/src/main/java/me/rerere/asr/providers/StepASRController.kt
+++ b/speech/src/main/java/me/rerere/asr/providers/StepASRController.kt
@@ -286,13 +286,16 @@ class StepASRController(
                 return withContext(Dispatchers.IO) {
                     httpClient.newCall(request).execute().use { resp ->
                         if (!resp.isSuccessful) {
-                            throw IOException("Step ASR HTTP ${resp.code}: ${resp.body.string()}")
+                            // 只保留状态码：响应体可能回显识别文本，不进异常消息与日志。
+                            throw StepAsrHttpException(resp.code)
                         }
                         parseSseTranscript(resp.body.source())
                     }
                 }
             } catch (e: IOException) {
                 lastError = e
+                // 4xx 是鉴权/参数问题，重试没有意义，直接上抛。
+                if (e is StepAsrHttpException && e.code in 400..499) throw e
                 Log.w(TAG, "flushSegment attempt $attempt/$MAX_RETRY failed: ${e.message}")
                 if (attempt < MAX_RETRY) {
                     kotlinx.coroutines.delay(300L * attempt) // 指数退避: 300ms, 600ms
@@ -302,6 +305,8 @@ class StepASRController(
         throw lastError ?: IOException("Step ASR request failed")
     }
 
+    private class StepAsrHttpException(val code: Int) : IOException("Step ASR HTTP $code")
+
     private fun parseSseTranscript(source: BufferedSource): String {
         val transcript = StringBuilder()
         var eventType: String? = null
